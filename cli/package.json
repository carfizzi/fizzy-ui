{
  "name": "fizzy-ui",
  "version": "22.0.0",
  "description": "shadcn-style Angular components built on @angular/aria. Copy the source, own the code.",
  "keywords": ["angular", "components", "ui", "aria", "accessibility", "tailwind", "shadcn", "cli"],
  "homepage": "https://github.com/carfizzi/fizzy-ui#readme",
  "repository": { "type": "git", "url": "git+https://github.com/carfizzi/fizzy-ui.git", "directory": "cli" },
  "bugs": "https://github.com/carfizzi/fizzy-ui/issues",
  "type": "module",
  "bin": { "fizzy-ui": "index.mjs" },
  "files": ["index.mjs", "registry"],
  "scripts": { "prepack": "rm -rf registry && cp -R ../registry ./registry && rm -f registry/ui/*.spec.ts && cp ../README.md ../LICENSE .", "postpack": "rm -rf registry README.md LICENSE" },
